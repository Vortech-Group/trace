{
    "name": "vortech/laravel-trace",
    "description": "One-way, change-based synchronization of published Eloquent data between two Laravel applications: a source change feed and a remote pull engine.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sync",
        "change-feed",
        "eloquent",
        "incremental"
    ],
    "authors": [
        {
            "name": "Mate Papp",
            "email": "mate@vortech.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan-strict-rules": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Vortech\\Trace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vortech\\Trace\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortech\\Trace\\TraceServiceProvider"
            ],
            "aliases": {
                "Remote": "Vortech\\Trace\\Facades\\Remote"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
